MACROVISION_BACKEND_URL=http://127.0.0.1:8000
# Keep private for trusted-network development. Public deployment must set public.
MACROVISION_SECURITY_MODE=private
# Required in public mode. Use a random secret of at least 32 characters.
MACROVISION_WEB_SESSION_SECRET=
MACROVISION_WEB_RESEARCH_USER=
# Format: pbkdf2$sha256$<iterations>=310000$<salt-base64url>$<hash-base64url>
MACROVISION_WEB_RESEARCH_PASSWORD_HASH=
# Set only behind a reverse proxy that strips and rewrites X-Forwarded-For.
MACROVISION_TRUST_PROXY=0
